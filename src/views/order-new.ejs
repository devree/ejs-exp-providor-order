<%- include('layout/header') %>
<h1>สร้างออร์เดอร์</h1>

<div class="card">
  <form id="order-form" novalidate>
    <div class="form-group">
      <label for="provider">Provider</label>
      <select id="provider" name="provider" required>
        <option value="shopee">Shopee</option>
        <option value="tiktok">TikTok</option>
        <option value="lazada">Lazada</option>
      </select>
    </div>
    <div class="form-group">
      <label for="productCount">จำนวนสินค้าในออร์เดอร์ (1-<%= maxItems %> ชิ้น)</label>
      <input type="number" id="productCount" name="productCount" min="1" max="<%= maxItems %>" step="1" value="1" required data-max="<%= maxItems %>">
    </div>
    <button type="submit" id="submit-btn" class="btn btn-primary">Gen Order Data</button>
    <small style="color:var(--muted)">สินค้าในระบบ <%= productTotal %> รายการ</small>
  </form>
</div>

<div id="error-box" class="alert alert-error hidden" role="alert"></div>
<div id="result-card" class="card hidden"></div>
<%- include('layout/footer', { scripts: ['/js/order-new.js'] }) %>
