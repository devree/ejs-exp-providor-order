<%
  var fmtDate = function (d) {
    if (!d) return '—';
    var dt = new Date(d);
    if (isNaN(dt.getTime())) return '—';
    return dt.toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });
  };
  var fmtAmount = function (v) {
    var n = Number(v);
    return isNaN(n) ? String(v) : n.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var providerLabels = { shopee: 'Shopee', tiktok: 'TikTok', lazada: 'Lazada' };
%>
<%- include('layout/header') %>
<h1>คำสั่งซื้อ</h1>

<form method="get" action="/orders" class="toolbar">
  <label for="f-provider">Provider</label>
  <select id="f-provider" name="provider">
    <option value=""<%= !filters.provider ? ' selected' : '' %>>ทั้งหมด</option>
    <% Object.keys(providerLabels).forEach(function (k) { %>
    <option value="<%= k %>"<%= filters.provider === k ? ' selected' : '' %>><%= providerLabels[k] %></option>
    <% }) %>
  </select>
  <label for="f-pulled">สถานะการถูกดึง</label>
  <select id="f-pulled" name="pulled">
    <option value=""<%= !filters.pulled ? ' selected' : '' %>>ทั้งหมด</option>
    <option value="false"<%= filters.pulled === 'false' ? ' selected' : '' %>>ยังไม่ถูกดึง</option>
    <option value="true"<%= filters.pulled === 'true' ? ' selected' : '' %>>ถูกดึงแล้ว</option>
  </select>
  <button type="submit" class="btn btn-primary">ค้นหา/กรอง</button>
  <span class="spacer"></span>
  <span>ทั้งหมด <strong><%= total %></strong> รายการ</span>
  <button type="button" id="btn-reset-all" class="btn btn-danger" data-provider="<%= filters.provider || '' %>" data-provider-label="<%= providerLabels[filters.provider] || '' %>">รีเซ็ตทั้งหมด</button>
</form>

<div id="error-box" class="alert alert-error hidden" role="alert"></div>

<% if (orders.length === 0) { %>
  <div class="card empty">ยังไม่มีคำสั่งซื้อ</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Provider</th>
          <th class="num">จำนวนสินค้า</th>
          <th class="num">ยอดรวม</th>
          <th>เวลาสร้าง</th>
          <th>สถานะการถูกดึง</th>
          <th>เวลาที่ถูกดึง</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function (o) { %>
        <tr>
          <td><a href="/orders/<%= o.id %>"><code><%= o.externalOrderId %></code></a></td>
          <td><span class="badge badge-<%= o.provider %>"><%= providerLabels[o.provider] || o.provider %></span></td>
          <td class="num"><%= o.itemCount %></td>
          <td class="num">฿<%= fmtAmount(o.totalAmount) %></td>
          <td><%= fmtDate(o.createdAt) %></td>
          <td>
            <% if (o.isPulled) { %><span class="badge badge-pulled">ถูกดึงแล้ว</span>
            <% } else { %><span class="badge badge-pending">ยังไม่ถูกดึง</span><% } %>
          </td>
          <td><%= o.isPulled ? fmtDate(o.pulledAt) : '—' %></td>
          <td>
            <% if (o.isPulled) { %><button type="button" class="btn btn-secondary btn-sm btn-reset" data-id="<%= o.id %>">รีเซ็ต</button><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('partials/pagination', { page: page, totalPages: totalPages, basePath: '/orders', query: { provider: filters.provider, pulled: filters.pulled } }) %>
<% } %>
<%- include('layout/footer', { scripts: ['/js/orders.js'] }) %>
