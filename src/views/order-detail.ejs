<%
  var fmtDate = function (d) {
    if (!d) return '—';
    var dt = new Date(d);
    if (isNaN(dt.getTime())) return '—';
    return dt.toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });
  };
  var fmtAmount = function (v) {
    var n = Number(v);
    return isNaN(n) ? String(v) : n.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var providerLabels = { shopee: 'Shopee', tiktok: 'TikTok', lazada: 'Lazada' };
  var items = order.items || [];
%>
<%- include('layout/header') %>
<p><a href="/orders">&larr; กลับไปรายการคำสั่งซื้อ</a></p>
<h1>คำสั่งซื้อ #<%= order.id %></h1>
<div id="error-box" class="alert alert-error hidden" role="alert"></div>

<div class="card">
  <dl class="meta-grid">
    <div><dt>Order ID</dt><dd><code><%= order.externalOrderId %></code></dd></div>
    <div><dt>Provider</dt><dd><span class="badge badge-<%= order.provider %>"><%= providerLabels[order.provider] || order.provider %></span></dd></div>
    <div><dt>สกุลเงิน</dt><dd><%= order.currency %></dd></div>
    <div><dt>ยอดรวม</dt><dd>฿<%= fmtAmount(order.totalAmount) %></dd></div>
    <div><dt>จำนวนสินค้า</dt><dd><%= order.itemCount %></dd></div>
    <div><dt>เวลาสร้าง</dt><dd><%= fmtDate(order.createdAt) %></dd></div>
    <div><dt>สถานะการถูกดึง</dt><dd>
      <% if (order.isPulled) { %><span class="badge badge-pulled">ถูกดึงแล้ว</span>
      <% } else { %><span class="badge badge-pending">ยังไม่ถูกดึง</span><% } %>
    </dd></div>
    <div><dt>เวลาที่ถูกดึง</dt><dd><%= order.isPulled ? fmtDate(order.pulledAt) : '—' %></dd></div>
  </dl>
  <% if (order.isPulled) { %>
  <p><button type="button" class="btn btn-secondary btn-reset" data-id="<%= order.id %>">รีเซ็ตสถานะการถูกดึง</button></p>
  <% } %>
</div>

<h2>รายการสินค้า</h2>
<% if (items.length === 0) { %>
  <div class="card empty">ไม่มีรายการสินค้า</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ชื่อสินค้า</th>
          <th>SKU</th>
          <th class="num">จำนวน</th>
          <th class="num">ราคาต่อหน่วย (฿)</th>
          <th class="num">รวม (฿)</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function (it) { %>
        <tr>
          <td><%= it.productName %></td>
          <td><code><%= it.productSku %></code></td>
          <td class="num"><%= it.quantity %></td>
          <td class="num"><%= fmtAmount(it.unitPrice) %></td>
          <td class="num"><%= fmtAmount(it.lineTotal) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (order.provider === 'lazada') { %>
  <h2>หัวออร์เดอร์ (GetOrder / lazada-data)</h2>
  <pre class="json-view"><%= JSON.stringify(order.payload, null, 2) %></pre>
  <h2>รายการสินค้า (GetOrderItems / lazada-order-item)</h2>
  <pre class="json-view"><%= JSON.stringify(items.map(function (it) { return it.payload; }), null, 2) %></pre>
<% } else { %>
  <h2>Raw JSON (payload ของออร์เดอร์)</h2>
  <pre class="json-view"><%= JSON.stringify(order.payload, null, 2) %></pre>
<% } %>
<%- include('layout/footer', { scripts: ['/js/orders.js'] }) %>
